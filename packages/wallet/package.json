{
  "name": "weave",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "dev:node": "pnpm --filter @weave/node dev",
    "dev:wallet": "pnpm --filter @weave/wallet dev"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}